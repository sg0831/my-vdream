# 운영 EC2용. 로컬 개발은 기본값(SQLite)으로 충분하다.
DOMAIN=myvdream.example.com
GH_OWNER=your-github-id
APP_ENV=production
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=myvdream
MYSQL_USER=myvdream
MYSQL_PASSWORD=change-me
JWT_SECRET=change-me-to-a-32-plus-char-random-string
JWT_TTL_HOURS=24
DEMO_PASSWORD=demo1234!
STORAGE_BACKEND=s3
S3_BUCKET=my-vdream-uploads
S3_REGION=ap-northeast-2
CORS_ORIGINS=https://myvdream.example.com
MINIMUM_WAGE_HOURLY=10320
SEED_ON_EMPTY=true
